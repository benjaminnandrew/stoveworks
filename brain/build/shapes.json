  "kozy-heat": {
   "sorts_by": "By product type (gas fireplaces, gas inserts, gas stoves), with a fire-material filter: Rock, Glass, Log, Wood. No shape groups; some model pages name the shape (Bellingham: landscape; Callaway: linear; Nordik TL: tall linear).",
   "sources": [
    "https://www.kozyheat.com/products/gas-fireplaces",
    "https://www.kozyheat.com/products/gas-fireplace-inserts"
   ]
  },
  "town-country": {
   "sorts_by": "By indoor or outdoor, plus the Architectural Series. The fire is chosen by burner: logset burners (Birchwood, Chalet, Country Home, Heartwood) and glass and rock burners (Diamond, Tranquility), with See-Thru versions for the TC36 See-Thru. No shape groups; model names carry the shape (TC36 Arch, WS widescreen, See-Thru).",
   "sources": [
    "https://townandcountryfireplaces.com/",
    "https://townandcountryfireplaces.com/burner-overview/"
   ]
  },
  "pacific-energy": {
   "sorts_by": "Wood fireplaces by heating capacity (Small to Medium: FP16; Medium to Large: FP25; Large: FP30), and each size comes in a standard and an Arch version. Gas fireplaces are one short list with no groups.",
