{
 "checked_on": "2026-10-08",
 "rule": "Shapes and flame patterns use the maker's own words. A model gets a shape only where the maker states one: Mendota's shape pages, or another maker's model name, product page or published specs. Nothing is judged from photos. Front or door options (an arched screen front, arched or rectangular doors) are options, not the model's shape.",
 "groups": {
  "classic": "Traditional proportions: Mendota's Classic shape",
  "landscape": "Landscape format: Mendota's Landscape shape, Kozy Heat's Bellingham series",
  "linear": "A long, linear fire: makers call it Linear, Tall Linear or Widescreen",
  "arch": "An arched firebox, door or glass top",
  "rumford": "A Rumford-style firebox: shallow, with angled sides and a curved throat"
 },
 "viewing_options": {
  "single_sided": "viewed from the front (listed only where the maker offers it alongside other options)",
  "see_through": "viewed from two sides",
  "corner": "viewed from the front and one side",
  "three_sided": "viewed from the front and both sides (bay)",
  "indoor_outdoor": "one face indoors, one outdoors"
 },
 "brands": {
  "mendota": {
   "sorts_by": "Gas fireplaces by shape first (Mendota's \"Find your shape\"), then by flame pattern. Gas inserts by flame pattern only.",
   "shapes": [
