    "https://www.pacificenergy.net/wood-fireplaces/",
    "https://www.pacificenergy.net/gas-fireplaces/"
   ]
  },
  "rsf": {
   "sorts_by": "ICC lists its two fireplace brands side by side: RSF for heat (high efficiency) and Renaissance for ambiance (decorative). No shape groups.",
