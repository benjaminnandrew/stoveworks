# Copy to .env.local for development. On Replit, set these as Secrets (the workspace
# list and, for the published site, "Production app secrets").

# Canonical origin. Magic-link sign-in emails are built from this, so it MUST be
# correct in production — it is deliberately not derived from request headers.
SITE_URL=https://stoveworksinc.com

# Postgres. Leave unset in development to use the in-process PGlite database
# under var/pgdata instead.
# DATABASE_URL=postgresql://user:pass@host:5432/stoveworks

# Transactional email for sign-in links. Without SMTP_URL, emails are printed to
# the server console instead of being sent — fine for development, not for live.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="Hayward Stoveworks <no-reply@stoveworksinc.com>"

# Where files are kept: the catalog's photos and PDFs, customer room photos, and
# the cutouts and swatches staff upload. "local" (the default off Replit) uses
# folders on disk; "replit" (the default on Replit) uses the app's App Storage
# bucket, because a published Replit app has no lasting disk.
# FILE_STORE=local

# Local folders, used when FILE_STORE is local.
# BRAIN_ASSETS_DIR=var/brain-assets
# UPLOAD_DIR=/var/lib/stoveworks/uploads

# App Storage bucket, when it isn't the app's default bucket.
# APP_STORAGE_BUCKET=
