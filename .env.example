# Copy to .env.local for development, or set these on the VM for production.

# Canonical origin. Magic-link sign-in emails are built from this, so it MUST be
# correct in production — it is deliberately not derived from request headers.
SITE_URL=https://stoveworksinc.com

# Postgres. Leave unset in development to use the in-process PGlite database
# under var/pgdata instead.
# DATABASE_URL=postgresql://user:pass@host:5432/stoveworks

# Transactional email for sign-in links. Without SMTP_URL, emails are printed to
# the server console instead of being sent — fine for development, not for live.
# SMTP_URL=smtps://user:pass@smtp.example.com:465
# MAIL_FROM="The Stove Works <no-reply@stoveworksinc.com>"

# Where customer room photos are written. Defaults to var/uploads.
# UPLOAD_DIR=/var/lib/stoveworks/uploads
